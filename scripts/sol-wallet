#!/usr/bin/env bash
set -euo pipefail

# Follow the latest image built from this repository's default branch. Forks
# and callers testing another image can override this with SOL_WALLET_IMAGE.
IMAGE="${SOL_WALLET_IMAGE:-ghcr.io/cainiaocome/sol-wallet:master}"
CONFIG_DIR="${SOL_WALLET_CONFIG_DIR:-$HOME/.config/sol-wallet}"

mkdir -p "$CONFIG_DIR"

TTY_ARGS=()
if [[ -t 0 && -t 1 ]]; then
  TTY_ARGS=(-it)
else
  TTY_ARGS=(-i)
fi

# Match the mounted directory's host ownership. The image's default UID is
# 10001 for direct use; the wrapper uses the caller's UID/GID for 0700 mounts.
USER_ARGS=(--user "$(id -u):$(id -g)")

# Always refresh the configured tag before launching so a cached image never
# silently hides a newer published release. With `set -e`, pull failures stop
# here instead of falling back to stale local content.
docker pull "$IMAGE"

exec docker run --rm \
  "${TTY_ARGS[@]}" \
  "${USER_ARGS[@]}" \
  -v "$CONFIG_DIR:/home/solwallet/.config/sol-wallet" \
  "$IMAGE" \
  "$@"
